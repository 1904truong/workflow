{
  "manifest_version": 3,
  "name": "Flow Bridge - AI Image Studio",
  "version": "1.0.0",
  "description": "Bridge between AI Image Studio and Google Flow",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://localhost:3000/*"
    ]
  },
  "action": {
    "default_title": "Flow Bridge Status"
  }
}
