{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["../../packages/shared/*"]
    },
    "types": ["chrome"]
  },
  "include": ["src/**/*", "../../packages/**/*"]
}
