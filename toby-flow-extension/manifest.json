{
  "manifest_version": 3,
  "name": "Flow Bridge - Auto Flow & Auto Creative",
  "version": "1.0.0",
  "description": "Tự động hóa tạo ảnh, video và quản lý tác vụ hàng loạt trên Google Flow.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "downloads",
    "activeTab",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://labs.google/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Mở Flow Bridge Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "fb-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "guard.js",
        "flow-config.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.magnific.com/search*",
        "https://magnific.com/search*"
      ],
      "css": [
        "magnific-compact.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.css"
      ],
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/*"
      ]
    }
  ]
}